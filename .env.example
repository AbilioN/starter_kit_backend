APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Where a browser lands after tenant signup (the Nuxt admin panel's host).
TENANT_DOMAIN=starterkit.test:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Set to `json` wherever logs are collected rather than read by eye: one JSON
# object per line on stderr, with the shared context (request_id, tenant_id)
# as fields. See config/logging.php.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=starter_kit_backend
DB_USERNAME=starter_kit_backend
DB_PASSWORD=password

# `sessions` lives on the landlord connection (GodAdmin is a landlord actor, and
# the default connection is never migrated by the documented setup). Without
# SESSION_CONNECTION, the database driver looks the table up on DB_CONNECTION
# and /god/login returns 500.
SESSION_DRIVER=database
SESSION_CONNECTION=landlord
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=1553073
PUSHER_APP_KEY=b395ac035994ca7af583
PUSHER_APP_SECRET=8a20e39fc3f1ab6111af
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Must stay empty: phpredis prefixes every raw Redis::-facade key with this
# value, which would silently split the openai_requests/openai_responses
# lists shared with starter_kit_ai_microservice's Python worker into a
# separate, invisible keyspace. See ProcessOpenAIRequest.php.
REDIS_PREFIX=

HORIZON_DOMAIN=
HORIZON_PATH=horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3-compatible (DigitalOcean Spaces, MinIO, etc.)
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"


# --- Readiness thresholds (GET /api/health/ready, php artisan health:check) ---
# What counts as "degraded". Defaults live in config/health.php; override here
# per environment. HEALTH_AI_* watch the raw Redis lists shared with
# starter_kit_ai_microservice, which Horizon does not see.
# HEALTH_AI_MAX_DEPTH=20
# HEALTH_AI_MAX_AGE_SECONDS=120
# HEALTH_AI_HEARTBEAT_MAX_AGE_SECONDS=60
# HEALTH_FAILED_JOBS_WINDOW_MINUTES=15
# HEALTH_FAILED_JOBS_MAX=0


# --- Backups (roadmap 5.3) ---
# Destination of last resort: used when neither the tenant nor its plan names a
# `backup` InfrastructureProvider. This is the END of the chain, not an extra —
# with nothing here and no provider assigned, a backup run FAILS and is recorded
# as failed rather than being silently skipped.
#
# Keep this separate from the AWS_* uploads bucket. A backup living in the
# bucket it exists to protect is not a backup.
BACKUP_DRIVER=local
BACKUP_ROOT=/var/www/storage/app/backups
# BACKUP_DRIVER=s3
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_DEFAULT_REGION=us-east-1
# BACKUP_BUCKET=
# BACKUP_ENDPOINT=
# BACKUP_USE_PATH_STYLE_ENDPOINT=true

# Dumps are encrypted before upload. This key is deliberately NOT APP_KEY:
# sharing them means the incident that takes out the app also takes out the
# ability to read its backups. Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

# Fallback plan policy, for a plan that sets no limits.backup_* keys.
# BACKUP_DEFAULT_FREQUENCY_HOURS=24
# BACKUP_DEFAULT_RETENTION_DAYS=30
# BACKUP_DEFAULT_MAX_TOTAL_MB=


# --- Alerting (roadmap 5.1.E) ---
# The scheduled `health:check --alert` (every 5 min) is what actually tells
# someone. Detection has existed since 5.1; without a destination here it only
# writes a log line, which is what "no alerting" looks like.
#
# Several destinations may be on at once — each is tried independently, so a
# revoked Slack webhook does not cost the e-mail.
ALERT_MAIL_ENABLED=true
# Comma-separated. Operators, not tenants: these alerts name tenants.
ALERT_MAIL_TO=
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=

# Noise control — the settings that decide whether anyone still reads alerts in
# two weeks. Consecutive failing runs before the first message (a single blip is
# not an incident), and how long before an unresolved problem is repeated.
# ALERT_MIN_OCCURRENCES=2
# ALERT_REPEAT_AFTER_MINUTES=180
# ALERT_NOTIFY_RECOVERY=true

# ---------------------------------------------------------------------------
# Error tracking (roadmap 5.1.B)
# ---------------------------------------------------------------------------
# Empty DSN = the SDK is installed and inert. Nothing is sent anywhere, which
# is the intended default: whether stack traces from a multi-tenant BtoB
# product may leave this infrastructure is a data-residency decision, not a
# packaging one.
#
# The SDK speaks the Sentry protocol, and both candidates accept it — Sentry's
# hosted service, or a self-hosted GlitchTip. Point the DSN at either; no code
# changes either way, and the decision stays reversible.
#
# PII stays off by default: with send_default_pii=true the reports carry user
# e-mail addresses and IPs, which for this product means a tenant's customers.
# Note before switching it on that an exception MESSAGE can still contain
# credentials (a PDOException quotes its DSN) — that is not covered by this
# flag.
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
# Errors only. Performance tracing is billed by volume and is a separate
# decision from "tell me when something breaks".
SENTRY_TRACES_SAMPLE_RATE=0

# --- Agent tools (roadmap 4.11) -------------------------------------------
# EMPTY DISABLES THE FEATURE. With no worker key the tool-call endpoint 404s
# and no grant is ever minted, so an AI turn is byte-identical to one from
# before agent tools existed. That is the intended default: whether an AI agent
# may read a tenant's data is the operator's decision, not a deploy's.
AGENT_TOOLS_WORKER_KEY=
AGENT_TOOLS_GRANT_TTL=300
AGENT_TOOLS_MAX_ROUNDS=3
AGENT_TOOLS_MAX_CALLS=6
AGENT_TOOLS_MAX_ROWS=50
AGENT_TOOLS_MAX_RESULT_BYTES=24000
AGENT_TOOLS_ENDPOINT=http://webserver/api/internal/agent/tool-call
